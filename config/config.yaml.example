# Copy to config/config.yaml and add your subscription-generated
# proxies / proxy-groups / rules below.

mixed-port: 7890
allow-lan: true
bind-address: "*"
mode: rule
log-level: info

external-controller: 0.0.0.0:9090
secret: "CHANGE-ME-to-a-long-random-secret"

# Enable this only if the dashboard reports a CORS error.
# external-controller-cors:
#   allow-origins:
#     - "http://*"
#     - "https://*"
#   allow-private-network: true

# proxies:
# proxy-groups:
# rules:

